# ==============================================================================
# POWER SILICON TECHNOLOGIES — APACHE / LITESPEED / CPANEL CONFIGURATION
# ==============================================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Support extensionless HTML URLs (e.g. /about -> /about.html)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# MIME Types
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest .json
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType image/x-icon .ico
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Custom Error Pages
ErrorDocument 404 /404.html

# Security & Cache Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Static Media Caching (Images, Webmanifest, Icons)
  <FilesMatch "\.(ico|png|jpg|jpeg|webp|svg|webmanifest|json|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML & Sitemaps Caching
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# GZIP / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
