{
  "name": "power-silicon-website",
  "version": "1.0.0",
  "description": "Official corporate website for Power Silicon Technologies Pvt. Ltd.",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "serve": "node server.js",
    "app": "electron .",
    "build:exe": "electron-packager . \"Power Silicon Technologies\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=app-icon.ico --asar --prune=true --ignore=\"^/(dist|\\.git|\\.github)\"",
    "test": "node validate.js"
  },
  "keywords": [
    "vlsi",
    "semiconductor",
    "asic",
    "soc",
    "embedded",
    "power-silicon"
  ],
  "author": "Power Silicon Technologies Pvt. Ltd.",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  }
}
